# Environment Configuration

# Legacy orchestrator defaults. Phase 1 uses Ollama only.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.95

# Paid AI API keys are intentionally absent.

# Orchestrator Configuration
NUM_MANAGERS=2
WORKERS_PER_MANAGER=2
COMMANDER_THINK_TIME=2.0
MANAGER_PLAN_TIME=1.0
WORKER_EXECUTE_TIME=0.5
MANAGER_RETRY_LIMIT=3
WORKER_RETRY_LIMIT=3
TASK_TIMEOUT_SECONDS=300

# Parallel Execution
MANAGER_PARALLEL_WORKERS=3
ENABLE_ASYNC_EXECUTION=true

# Skill System
SKILL_CACHE_ENABLED=true
SKILL_CACHE_TTL_SECONDS=3600
SKILL_VERSION_RETENTION=10
SKILL_EXECUTION_LOG_ENABLED=true
SKILLS_ZERO_TOKEN_MODE=true

# RAG Configuration
RAG_GRAPH_TYPE=networkx
GRAPH_MAX_DEPTH=5
GRAPH_RETRIEVAL_STRATEGY=semantic
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_RETRIEVE_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=100
VECTOR_STORE_TYPE=faiss

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
MCP_ENABLE_CORS=true
MCP_AUTO_DISCOVER_TOOLS=true
MCP_TOOL_TIMEOUT=30

# Work Management
WORK_VERSIONING_ENABLED=true
WORK_VERSION_HISTORY_SIZE=50
WORK_COMPARISON_ENABLED=true
EXECUTION_LOG_RETENTION_DAYS=30
EXECUTION_LOG_VERBOSE=false

# Database
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./data/orchestrator.db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT={time:YYYY-MM-DD HH:mm:ss} | {level: <8} | {name}:{function}:{line} - {message}
LOG_RETENTION_DAYS=7

# Performance
ENABLE_MEMORY_OPTIMIZATION=true
MAX_MEMORY_PERCENT=80.0
BATCH_SIZE=32
PREFETCH_SIZE=2

# Development
DEBUG_MODE=false
ENABLE_PROFILING=false
DRY_RUN_MODE=false

# System
COMMANDER_NAME=Chief Commander
# Optional communication connectors. Keep real values only in your local .env.
DAKSH_CONNECTOR_POLL_SECONDS=0
DAKSH_TELEGRAM_BOT_TOKEN=
DAKSH_TELEGRAM_ALLOWED_CHATS=
DAKSH_TELEGRAM_REPLY=true
DAKSH_TELEGRAM_EMAIL_PREVIEW=false
DAKSH_GMAIL_QUERY=newer_than:7d
DAKSH_GMAIL_MAX_RESULTS=10
DAKSH_GMAIL_AUTO_DRAFT=true
DAKSH_CALENDAR_LOOKAHEAD_DAYS=14
DAKSH_CALENDAR_MAX_RESULTS=20
DAKSH_WHATSAPP_VERIFY_TOKEN=
DAKSH_WHATSAPP_APP_SECRET=
DAKSH_WHATSAPP_ALLOWED_NUMBERS=
DAKSH_ALLOW_EXTERNAL_WEBHOOKS=false
