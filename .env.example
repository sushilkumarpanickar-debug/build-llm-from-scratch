# Environment Configuration

# LLM Provider (openai, anthropic, local, ollama)
LLM_PROVIDER=local
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.95

# API Keys (if using cloud providers)
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# Keep false to guarantee no API-credit usage. Enable temporarily only while
# evaluating cloud fallbacks during the local-model transition.
CLOUD_FALLBACK_ENABLED=false

# Orchestrator Configuration
NUM_MANAGERS=2
WORKERS_PER_MANAGER=2
COMMANDER_THINK_TIME=2.0
MANAGER_PLAN_TIME=1.0
WORKER_EXECUTE_TIME=0.5
MANAGER_RETRY_LIMIT=3
WORKER_RETRY_LIMIT=3
TASK_TIMEOUT_SECONDS=300

# Parallel Execution
MANAGER_PARALLEL_WORKERS=3
ENABLE_ASYNC_EXECUTION=true

# Skill System
SKILL_CACHE_ENABLED=true
SKILL_CACHE_TTL_SECONDS=3600
SKILL_VERSION_RETENTION=10
SKILL_EXECUTION_LOG_ENABLED=true
SKILLS_ZERO_TOKEN_MODE=true

# RAG Configuration
RAG_GRAPH_TYPE=networkx
GRAPH_MAX_DEPTH=5
GRAPH_RETRIEVAL_STRATEGY=semantic
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_RETRIEVE_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=100
VECTOR_STORE_TYPE=faiss

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
MCP_ENABLE_CORS=true
MCP_AUTO_DISCOVER_TOOLS=true
MCP_TOOL_TIMEOUT=30

# Work Management
WORK_VERSIONING_ENABLED=true
WORK_VERSION_HISTORY_SIZE=50
WORK_COMPARISON_ENABLED=true
EXECUTION_LOG_RETENTION_DAYS=30
EXECUTION_LOG_VERBOSE=false

# Database
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./data/orchestrator.db

# Shared DAKSH memory. The default is this iCloud Drive directory on macOS.
DAKSH_DATA_DIR="~/Library/Mobile Documents/com~apple~CloudDocs/DAKSH"

# Keep DAKSH local; publish it privately with Tailscale Serve.
DAKSH_WEB_HOST=127.0.0.1
DAKSH_WEB_PORT=9000

# Automatic OpenCode coding jobs run only in this repository, use only local
# Ollama qwen2.5:3b, and expose bounded status through the local dashboard.
DAKSH_OPENCODE_TIMEOUT_SECONDS=300
DAKSH_OPENCODE_MAX_OUTPUT_BYTES=65536

# Logging
LOG_LEVEL=INFO
LOG_FORMAT={time:YYYY-MM-DD HH:mm:ss} | {level: <8} | {name}:{function}:{line} - {message}
LOG_RETENTION_DAYS=7

# Performance
ENABLE_MEMORY_OPTIMIZATION=true
MAX_MEMORY_PERCENT=80.0
BATCH_SIZE=32
PREFETCH_SIZE=2

# Development
DEBUG_MODE=false
ENABLE_PROFILING=false
DRY_RUN_MODE=false

# System
COMMANDER_NAME=Chief Commander
